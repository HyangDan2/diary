---
layout: base.njk
---
{% import "parts/lang-switch.njk" as langSwitch %}
{% set pageLang = 'en' if lang == 'en' else 'ko' %}
<article class="post shell">
    <div class="page-top">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="{{ '/' | url }}">Diary</a>
            <span aria-hidden="true">/</span>
            <a href="{{ categoryUrl | url }}">{{ categoryName }}</a>
        </nav>
        {% if alternateKo and alternateEn %}{{ langSwitch.langSwitch(pageLang, alternateKo, alternateEn) }}{% endif %}
    </div>

    <header class="post-header">
        <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{{ categoryName }} · {{ date | displayDate }}</p>
        <h1>{{ title }}</h1>
        {% if summary %}<p class="post-summary">{{ summary }}</p>{% endif %}
        <div class="post-meta">
            <span class="badge">{{ categoryName }}</span>
            {% if pageLang == 'en' %}
            <time datetime="{{ date | htmlDate }}">{{ date | displayDate }}</time>
            <span>{{ content | readingTime }} min read</span>
            {% else %}
            <time datetime="{{ date | htmlDate }}">{{ date | koreanDate }}</time>
            <span>{{ content | readingTime }}분 읽기</span>
            {% endif %}
            {% set tagItems = tags | tagList %}
            {% if tagItems.length %}
            <span class="post-tags">
                {% for tag in tagItems %}<span class="tag">#{{ tag }}</span>{% endfor %}
            </span>
            {% endif %}
        </div>
    </header>

    <div class="md-body post-content">
        {{ content | safe }}
    </div>

    <nav class="post-nav" aria-label="Post navigation">
        <a class="post-nav-item" href="{{ '/' | url }}">
            <span class="post-nav-label">Diary</span>
            <strong>{% if pageLang == 'en' %}All posts{% else %}전체 글 목록{% endif %}</strong>
        </a>
        <a class="post-nav-item" href="{{ categoryUrl | url }}">
            <span class="post-nav-label">Category</span>
            <strong>{{ categoryName }}</strong>
        </a>
    </nav>

    {% if newerPost or olderPost %}
    <nav class="post-pager" aria-label="Previous and next posts">
        {% if newerPost %}
        <a class="pager-item pager-newer" href="{{ newerPost.url | url }}">
            <span>{% if pageLang == 'en' %}← Newer{% else %}← 최신 글{% endif %}</span>
            <strong>{{ newerPost.data.title }}</strong>
        </a>
        {% else %}<span class="pager-item pager-empty" aria-hidden="true"></span>{% endif %}
        {% if olderPost %}
        <a class="pager-item pager-older" href="{{ olderPost.url | url }}">
            <span>{% if pageLang == 'en' %}Older →{% else %}이전 글 →{% endif %}</span>
            <strong>{{ olderPost.data.title }}</strong>
        </a>
        {% else %}<span class="pager-item pager-empty" aria-hidden="true"></span>{% endif %}
    </nav>
    {% endif %}
</article>
