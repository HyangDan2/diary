{% macro postList(posts, showCategory = true) %}
<ul class="post-list">
    {% for post in posts %}
    <li class="post-row" lang="{{ 'en' if post.data.lang == 'en' else 'ko' }}" data-post-url="{{ post.url }}">
        <a class="post-row-link" href="{{ post.url | url }}">
            <span class="post-row-meta">
                <time datetime="{{ post.date | htmlDate }}">{{ post.date | displayDate }}</time>
                {% if showCategory %}<span class="badge">{{ post.data.categoryName }}</span>{% endif %}
            </span>
            <span class="post-row-body">
                <strong class="post-row-title">{{ post.data.title }}</strong>
                {% if post.data.summary %}<span class="post-row-summary">{{ post.data.summary }}</span>{% endif %}
            </span>
            <span class="post-row-arrow" aria-hidden="true">↗</span>
        </a>
        {% set tagItems = post.data.tags | tagList %}
        <div class="post-row-tags"{% if not tagItems.length %} data-empty="true"{% endif %}>
            {% for tag in tagItems %}<button class="post-tag" type="button" data-tag="{{ tag }}" aria-pressed="false"><span class="post-tag-hash" aria-hidden="true">#</span>{{ tag }}</button>{% endfor %}
        </div>
    </li>
    {% endfor %}
</ul>
{% endmacro %}

{% macro emptyState(message) %}
<div class="empty-state">
    <p>{{ message }}</p>
</div>
{% endmacro %}
