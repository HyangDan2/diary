    <main id="main">
        {{ content | safe }}
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <span>© {{ site.year }} {{ site.brand }}</span>
            <span class="footer-note">++ BUILD NOTES ++ KEEP SHIPPING ++</span>
            <span class="visit-badge" data-visit-badge hidden>
                <svg class="visit-eye" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1.7 8S3.9 4.1 8 4.1 14.3 8 14.3 8 12.1 11.9 8 11.9 1.7 8 1.7 8Z"/><circle cx="8" cy="8" r="1.9"/></svg>
                <span>Today <b class="visit-num" data-visit-today>—</b></span>
                <span class="visit-sep" aria-hidden="true">·</span>
                <span>Total <b class="visit-num" data-visit-total>—</b></span>
            </span>
            <a href="{{ site.hqUrl }}">{{ site.hqLabel }} <span aria-hidden="true">↗</span></a>
        </div>
    </footer>
    {# link share / copy — the bottom-right button the theme toggle used to be #}
    <button class="hd2-share-fab" type="button" data-hd2-share
            aria-label="{% if pageLang == 'en' %}Share this page{% else %}이 페이지 링크 공유{% endif %}"
            title="{% if pageLang == 'en' %}Share this page{% else %}이 페이지 링크 공유{% endif %}"
            data-copied-ko="링크가 복사되었어요" data-copied-en="Link copied"
            data-failed-ko="링크를 복사하지 못했어요" data-failed-en="Could not copy the link">
