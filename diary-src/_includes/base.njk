{#- the language this page is written in: a post's own `lang`, or its drawer's — Notes stays Korean, the English drawers are English -#}
{%- set pageLang = (lang or '') | docLang(categoryPage) -%}
{%- set pageDescription = description or summary or (categoryPage.blurbEn if categoryPage and pageLang == 'en' else site.description) -%}
<!DOCTYPE html>
<html lang="{{ pageLang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#FAFAFD">
    <title>{% if categoryPage %}{{ categoryPage.name }} · {% elif title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <meta property="og:type" content="{% if page.url and page.url.includes('/posts/') %}article{% else %}website{% endif %}">
    <meta property="og:site_name" content="HD2Lab · {{ site.name }}">
    <meta property="og:title" content="{% if categoryPage %}{{ categoryPage.name }} · {% elif title %}{{ title }} · {% endif %}{{ site.name }}">
    <meta property="og:description" content="{{ description or summary or site.tagline }}">
    {# social card — one 1200×630 HD2Lab card for every page (no per-post image in the diary yet) #}
    {%- set ogImageUrl = site.origin + (site.ogImage | url) + '?v=' + site.ogImageVersion -%}
    {%- set ogImageAlt = "HD2Lab · HD2's Diary — build log: what I made, and what broke." -%}
    <meta property="og:image" content="{{ ogImageUrl }}">
    <meta property="og:image:secure_url" content="{{ ogImageUrl }}">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ ogImageAlt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if categoryPage %}{{ categoryPage.name }} · {% elif title %}{{ title }} · {% endif %}{{ site.name }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ ogImageUrl }}">
    <meta name="twitter:image:alt" content="{{ ogImageAlt }}">
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}?v=20261116-softiris">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/favicon-32x32.png' | url }}?v=20261116-softiris">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/apple-touch-icon.png' | url }}?v=20261106">
    {# the same page in the other language, when both editions exist #}
    {% if alternateKo %}<link rel="alternate" hreflang="ko" href="{{ alternateKo | url }}">{% endif %}
    {% if alternateEn %}<link rel="alternate" hreflang="en" href="{{ alternateEn | url }}">{% endif %}
    {% if alternateKo and alternateEn %}<link rel="alternate" hreflang="x-default" href="{{ alternateKo | url }}">{% endif %}
    <script>try{var h=localStorage.getItem('hd2-theme');document.documentElement.setAttribute('data-theme',h==='dark'?'dark':'light');}catch(e){document.documentElement.setAttribute('data-theme','light');}</script>
    <link rel="stylesheet" href="{{ '/assets/hd2-theme.css' | url }}?v=20261124-slide">
    <script src="{{ '/assets/hd2-theme.js' | url }}?v=20261124-slide" defer></script>
    <link rel="stylesheet" href="{{ '/assets/diary.css' | url }}?v=20261124-slide">
    <link rel="stylesheet" href="{{ '/assets/hd2-share.css' | url }}?v=20261124-slide">
    <script data-goatcounter="https://hd2lab.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</head>
<body class="page-{{ page.url | slugify }}">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.name }} home">
                <span class="mark" aria-hidden="true"></span>
                <span class="brand-name">{{ site.brand }}</span>
                <em>{{ site.name }}</em>
            </a>
            {# which Diary link is the current one: Top on /diary/, the category elsewhere #}
            {% set diaryHome = '/' %}
            {% set diarySub = 'top' if page.url == diaryHome else (categoryPage.slug if categoryPage else (categorySlug if categorySlug else '')) %}
            <nav class="header-nav" aria-label="Hub categories">
                <a class="nav-tab" href="https://hyangdan2.github.io/">Web-HQ</a>
