                    </div>
                </div>
                <div class="nav-dropdown" data-nav-group="info">
                    <a class="nav-tab nav-dropdown-trigger" href="https://hyangdan2.github.io/InformationHub/">Info<span class="nav-caret" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 10 10" focusable="false"><path d="M1.8 3.5 5 6.7l3.2-3.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
                    <div class="nav-dropdown-panel">
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/InformationHub/china-ai/">China AI</a>
                        <a class="nav-dropdown-link" href="https://hyangdan2.github.io/InformationHub/us-markets/">US Markets</a>
                    </div>
                </div>
                <a class="nav-tab" href="https://hyangdan2.github.io/about/">About</a>
            </nav>
            <div class="header-actions">
                <span class="theme-slot" data-hd2-theme-slot></span>
                <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M3 5.5H17M3 10H17M3 14.5H17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        </div>
    </header>

