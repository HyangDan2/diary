            <path d="M15.3 6.35 8.7 10.05M8.7 13.95l6.6 3.7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
            <circle cx="18" cy="5.2" r="2.7" fill="currentColor"/>
            <circle cx="6" cy="12" r="2.7" fill="currentColor"/>
            <circle cx="18" cy="18.8" r="2.7" fill="currentColor"/>
        </svg>
    </button>
    <div class="hd2-share-toast" data-hd2-share-toast role="status" aria-live="polite"></div>
    <script src="{{ '/assets/hd2-share.js' | url }}?v=20261124-slide" defer></script>
    <script src="{{ '/assets/visit-badge.js' | url }}?v=20261120-visits" defer></script>
    {% if pageScript %}<script src="{{ pageScript | url }}?v=20261119-koen" defer></script>{% endif %}
    <script src="{{ '/assets/diary-nav.js' | url }}?v=20261121-nav15" defer></script>
