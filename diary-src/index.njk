---
layout: base.njk
title: ""
lang: en
description: "Build notes from HD2Lab — Devlog, Architecture, Troubleshooting and Notes: what I make, what shifts, and what broke on the way."
pageScript: "/assets/diary-search.js"
---
{% import "parts/post-list.njk" as parts %}
{% import "parts/search.njk" as search %}
{% set posts = collections.diaryPosts %}
{% set categories = collections.diaryCategories %}
{% set recent = posts.slice(0, 5) %}
{% set latest = posts[0] or null %}

<section class="hero shell" aria-labelledby="diary-title">
    <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>HD2Lab / Diary</p>
        <h1 id="diary-title">Build it. Break it.<br><span>Write it down.</span></h1>
        <p class="hero-description">Where fleeting ideas find a gentler place to rest.</p>
        <div class="hero-actions">
            <a class="button button-primary" href="#recent">Read recent notes</a>
            <a class="button button-ghost" href="#categories">Explore the drawers</a>
        </div>
        <dl class="hero-stats">
            <div><dt>Posts</dt><dd>{{ posts | length }}</dd></div>
            <div><dt>Categories</dt><dd>{{ categories | length }}</dd></div>
            <div><dt>Last update</dt><dd>{% if latest %}{{ latest.date | displayDate }}{% else %}—{% endif %}</dd></div>
        </dl>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <div class="hero-terminal">
            <span class="terminal-bar"><i></i><i></i><i></i></span>
            <pre><code><span class="t-dim">$</span> ls diary/
<span class="t-accent">devlog</span>  <span class="t-accent">architecture</span>
<span class="t-accent">troubleshooting</span>  <span class="t-accent">notes</span>

<span class="t-dim">$</span> cat latest.md
<span class="t-text">{% if latest %}{{ latest.data.title }}{% else %}No notes yet.{% endif %}</span>
<span class="t-dim">$</span> <span class="t-cursor">▌</span></code></pre>
        </div>
        <p>Record <span>+</span> Review <span>+</span> Repeat</p>
    </div>
</section>

<section class="categories shell" id="categories" aria-labelledby="categories-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Categories</p>
            <h2 id="categories-title">Four quiet drawers.</h2>
        </div>
        <p>Thoughts settle by theme. Open a drawer to browse every note.</p>
    </div>
    <nav class="category-grid" aria-label="Diary categories">
        {% for category in categories %}
        <a class="category-card" href="{{ ('/categories/' + category.slug + '/') | url }}">
            <span class="card-index">{{ category.index }} / {{ category.name | upper }}</span>
            <span class="category-name">{{ category.name }}</span>
            <span class="category-blurb">{{ category.blurbEn or category.blurb or 'A small collection on this theme.' }}</span>
            <span class="category-foot">
                <span class="category-count">{{ category.count }} post{% if category.count != 1 %}s{% endif %}</span>
                <span class="category-latest">{% if category.latest %}Latest {{ category.latest | relativeDate('en') }}{% else %}No notes yet{% endif %}</span>
            </span>
        </a>
        {% endfor %}
    </nav>
</section>

<section class="recent shell" id="recent" aria-labelledby="recent-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Recent</p>
            <h2 id="recent-title">Recent notes.</h2>
        </div>
        <p>{% if posts | length %}{{ posts | length }} notes so far{% else %}Waiting for a first note{% endif %}</p>
    </div>
    {% if posts | length %}
        {{ search.searchBar({ mode: 'home', lang: 'en', total: posts | length, categories: categories, placeholder: 'Search titles · summaries · tags (try: git, exif, ci)' }) }}
        {{ search.searchResults('en') }}
        <div data-search-default>
            {{ parts.postList(recent) }}
        </div>
    {% else %}
        {{ parts.emptyState('Nothing has been written down here yet.') }}
    {% endif %}
</section>

<section class="cta-band shell">
    <div>
        <h2>Four quiet drawers,<br><span>in one list.</span></h2>
        <p>Recent notes are above; everything by theme waits in the drawers.</p>
    </div>
    <a class="button button-primary" href="{{ '/categories/' | url }}">Browse every drawer <span aria-hidden="true">↗</span></a>
</section>
